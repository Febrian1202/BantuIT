# ==============================================================================
# BantuIT — Dokploy Production Environment Configuration (.env.prod.example)
# ==============================================================================
# Salin seluruh isi file ini ke tab "Environment" / "Environment Variables" 
# pada layanan/proyek Compose Anda di dashboard Dokploy.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DOCKER COMPOSE & CONTAINER IMAGES (GHCR)
# ------------------------------------------------------------------------------
IMAGE_REGISTRY=ghcr.io/febrian1202
APP_VERSION=latest

# Port pemetaan host di VPS (sesuaikan dengan port yang tersedia)
API_PORT=8000
WEB_PORT=3000

# ------------------------------------------------------------------------------
# 2. SHARED DATABASE (MariaDB / MySQL di Dokploy/VPS)
# ------------------------------------------------------------------------------
# Sesuaikan DB_HOST dengan nama container MariaDB di jaringan Docker bersama
# atau gunakan IP/hostname shared MariaDB Dokploy Anda.
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=BantuIT
DB_USERNAME=bantuit
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DATABASE_PRODUKSI

# ------------------------------------------------------------------------------
# 3. BACKEND LARAVEL CONFIGURATION (apps/api)
# ------------------------------------------------------------------------------
APP_NAME=BantuIT
APP_ENV=production
APP_DEBUG=false

# WAJIB: Generate APP_KEY baru menggunakan `php artisan key:generate --show`
APP_KEY=base64:GANTI_DENGAN_APP_KEY_LARAVEL_ANDA

# URL publik API (gunakan domain/subdomain dengan SSL HTTPS)
APP_URL=https://api.domainanda.com

# Domain frontend untuk sesi Sanctum (pisahkan koma jika multi-domain, TANPA https://)
SANCTUM_STATEFUL_DOMAINS=domainanda.com,helpdesk.domainanda.com

# URL frontend lengkap untuk proteksi CORS & redirect
FRONTEND_URL=https://domainanda.com

# Pengaturan Lokalisasi & Keamanan
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Session, Cache, & Queue (Menggunakan database driver)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mailer (Default: log; ganti ke smtp jika sudah ada mail server)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@domainanda.com"
MAIL_FROM_NAME="BantuIT Support"

# ------------------------------------------------------------------------------
# 4. FRONTEND NEXT.JS BFF CONFIGURATION (apps/web)
# ------------------------------------------------------------------------------
# Alamat komunikasi internal antarkontainer Docker (Web -> API)
# Karena berada dalam 1 Docker network, gunakan nama service: http://api:8000/api
API_BASE_URL=http://api:8000/api

# URL publik frontend untuk metadata SEO dan callback
NEXT_PUBLIC_APP_URL=https://domainanda.com
NEXT_PUBLIC_APP_VERSION=v1.0.0
